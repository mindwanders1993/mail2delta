# .env.example
# Copy this to .env or set these in your Databricks Cluster / Job environment variables.

# Microsoft 365 Entra ID Credentials
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Target Mailbox Address
MAILBOX_ADDRESS=svc_global_bi@adidas.com

# Target Delta Lake Table (Catalog.Schema.Table)
DELTA_TABLE_NAME=lakehouse_dev.sadp_jpdna_pool_lhdev.finops_ar_collections

# Configuration Path & Timezone
YAML_CONFIG_PATH=configs/customers.yaml
PIPELINE_TIMEZONE=Asia/Tokyo
